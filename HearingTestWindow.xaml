<Window x:Class="GraphiteCompanion.HearingTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тест слуха" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentGradient}">
                <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Эквалайзер под ваш слух" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="StepText" Foreground="{DynamicResource SubTextBrush}" Text="2–3 минуты · нужна тишина"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="InfoText" Margin="0,20,0,0" TextWrapping="Wrap" LineHeight="20">
            Наденьте наушники и выставьте обычную громкость, на которой слушаете музыку.
            Приложение будет по очереди играть тихие тоны разной высоты, постепенно делая их громче.
            Как только услышите звук — сразу нажмите «Слышу» (или пробел).
            <LineBreak/><LineBreak/>
            На время теста эквалайзер и эффекты отключатся. Это не медицинский тест — результат лишь подстраивает звук под ваши уши и наушники.
        </TextBlock>

        <!-- progress dots -->
        <ItemsControl x:Name="Dots" Margin="0,20,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Margin="0,16,0,0" Height="8" CornerRadius="4" Background="{DynamicResource TrackBrush}">
            <Border x:Name="LevelFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{DynamicResource AccentGradient}"/>
        </Border>

        <Grid Margin="0,22,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Cancel_Click" Content="Отмена"/>
            <Button x:Name="MainButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="170" Click="Main_Click">
                <TextBlock x:Name="MainButtonText" Text="Начать" FontSize="15"/>
            </Button>
        </Grid>
    </StackPanel>
</Window>
