<Window x:Class="GraphiteCompanion.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="356" SizeToContent="Height"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border Margin="12" CornerRadius="16" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentGradient}">
                    <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PresetText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DeviceText" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <CheckBox x:Name="EqSwitch" Grid.Column="2" Style="{StaticResource Switch}" Content="EQ" VerticalAlignment="Center"
                          Click="EqSwitch_Click" ToolTip="Эквалайзер вкл/выкл"/>
            </Grid>

            <!-- Modes -->
            <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="4" Margin="0,16,0,0">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="ModeGames" GroupName="FlyMode" Style="{StaticResource Segment}" Tag="Games" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Игры" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeMusic" GroupName="FlyMode" Style="{StaticResource Segment}" Tag="Music" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Музыка" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeMovies" GroupName="FlyMode" Style="{StaticResource Segment}" Tag="Movies" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Фильмы" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <!-- Volume -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="MuteButton" Style="{StaticResource IconToggle}" Click="Mute_Click" ToolTip="Звук вкл/выкл">
                    <TextBlock x:Name="MuteIcon" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                </ToggleButton>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="10,0"
                        VerticalAlignment="Center" ValueChanged="Volume_ValueChanged"/>
                <TextBlock x:Name="VolumeText" Grid.Column="2" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>

            <!-- Bottom row -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MicButton" Style="{StaticResource GhostButton}" Click="Mic_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MicIcon" Text="&#xE720;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MicText" Text="Микрофон вкл." Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Click="Open_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                        <TextBlock Text="Открыть" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
