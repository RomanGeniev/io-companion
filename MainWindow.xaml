<Window x:Class="GraphiteCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundShot"
        Width="1160" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <ScrollViewer x:Name="SidebarScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="4,2,0,18">
                    <Border x:Name="BrandLogo" Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SoundShot" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BrandSubtitle" Text="Наушники IO" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    </StackPanel>
                </StackPanel>

                <!-- Update available -->
                <Border x:Name="UpdateCard" Visibility="Collapsed" Background="{DynamicResource AccentGradient}" CornerRadius="14" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" Foreground="White" FontWeight="SemiBold" Text="Доступна новая версия"/>
                            <TextBlock x:Name="UpdateNotes" Foreground="#DDFFFFFF" FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="UpdateButton" Grid.Column="1" Margin="10,0,0,0" Click="Update_Click" Style="{StaticResource GhostButton}">
                            <TextBlock x:Name="UpdateButtonText" Text="Обновить"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Device -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="УСТРОЙСТВО"/>
                        <ComboBox x:Name="DeviceCombo" SelectionChanged="DeviceCombo_SelectionChanged" HorizontalAlignment="Stretch"/>
                        <Grid Margin="2,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SubTextBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0,0,0" Text="Поиск наушников…"
                                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock x:Name="BatteryText" Text="" Visibility="Collapsed" Margin="2,6,0,0"
                                   Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"
                                   ToolTip="Заряд батареи беспроводного устройства. Показывается, только если устройство отдаёт его по стандарту (HID Battery Page или BLE)."/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="MuteButton" Style="{StaticResource IconToggle}" Click="MuteButton_Click" ToolTip="Выключить звук">
                                <TextBlock x:Name="MuteIcon" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                            </ToggleButton>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="10,0"
                                    VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="VolumeText" Grid.Column="2" Text="—" Width="40" TextAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Earpads -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="PadCardTitle" Style="{StaticResource CardTitle}" Text="АМБУШЮРЫ"/>
                        <!-- what this device is: remembered per device -->
                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="4" Margin="0,0,0,10">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="KindHeadphones" GroupName="Kind" Style="{StaticResource Segment}" Tag="Headphones" Checked="Kind_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Наушники" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="KindSpeakers" GroupName="Kind" Style="{StaticResource Segment}" Tag="Speakers" Checked="Kind_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Колонки" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>
                        <Border x:Name="PadSelector" Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="4">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="PadFabric" GroupName="Pad" Style="{StaticResource Segment}" Content="Ткань" Tag="Fabric" Checked="Pad_Checked"/>
                                <RadioButton x:Name="PadLeatherette" GroupName="Pad" Style="{StaticResource Segment}" Content="Кожзам" Tag="Leatherette" Checked="Pad_Checked"/>
                                <RadioButton x:Name="PadVelour" GroupName="Pad" Style="{StaticResource Segment}" Content="Велюр" Tag="Velour" Checked="Pad_Checked"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock x:Name="PadHint" Margin="2,10,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Custom presets -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="МОИ ПРЕСЕТЫ"/>
                        <ListBox x:Name="CustomList" MaxHeight="170" SelectionChanged="CustomList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PresetItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="CustomEmpty" Text="Пока пусто. Настройте эквалайзер и сохраните результат здесь."
                                   FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="2,0,0,4"/>
                        <TextBlock Text="Название" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="2,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomName" MaxLength="40" KeyDown="CustomName_KeyDown" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="SaveCustom_Click"
                                    ToolTip="Сохранить текущие настройки эквалайзера">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                            </Button>
                        </Grid>
                        <Button x:Name="DeleteCustomButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Click="DeleteCustom_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="Удалить выбранный" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Click="ImportPresets_Click" ToolTip="Загрузить пресеты из файла">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Импорт" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="ExportPresets_Click" ToolTip="Сохранить все свои пресеты в файл">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Экспорт" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Click="ShareCode_Click" ToolTip="Получить короткий код текущего звука, чтобы отправить другу">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Поделиться" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="EnterCode_Click" ToolTip="Добавить пресет по коду от друга">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ввести код" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Style="{StaticResource AccentButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="AutoEq_Click"
                                ToolTip="Пресет, выравнивающий звук вашей модели наушников (открытая база AutoEq, ~5000 моделей)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="Пресет под мои наушники" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="ОФОРМЛЕНИЕ"/>
                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="4">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Segment}" Content="Тёмная" Tag="Dark" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Segment}" Content="Светлая" Tag="Light" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Segment}" Content="Системная" Tag="System" ToolTip="Как в настройках Windows" Checked="Theme_Checked"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Цвет" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="2,12,0,6"/>
                        <UniformGrid x:Name="AccentPanel" Columns="6"/>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="ПРИЛОЖЕНИЕ"/>
                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Content="Запускать вместе с Windows" Click="AutostartSwitch_Click"/>
                        <CheckBox x:Name="MinimizeSwitch" Style="{StaticResource Switch}" Content="Сворачивать в трей при закрытии" Click="MinimizeSwitch_Click"/>
                        <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Content="Сообщать о смене режима" Click="NotifySwitch_Click"/>
                        <CheckBox x:Name="OsdSwitch" Style="{StaticResource Switch}" Content="Подсказка на экране (поверх игр)" Click="OsdSwitch_Click"
                                  ToolTip="Вместо уведомлений Windows — короткая надпись по центру экрана"/>
                        <CheckBox x:Name="MicSoundsSwitch" Style="{StaticResource Switch}" Content="Звук при выключении микрофона" Click="MicSoundsSwitch_Click"/>
                        <CheckBox x:Name="DiscordSwitch" Style="{StaticResource Switch}" Content="Статус в Discord" Click="DiscordSwitch_Click"
                                  ToolTip="В профиле Discord видно «SoundShot · Игры»"/>
                        <StackPanel x:Name="DiscordSetup" Visibility="Collapsed" Margin="0,2,0,6">
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                       Text="Application ID приложения Discord (discord.com/developers → New Application → скопировать Application ID):"/>
                            <TextBox x:Name="DiscordIdBox" Margin="0,6,0,0" Padding="6,4" LostFocus="DiscordIdBox_LostFocus"/>
                            <TextBlock x:Name="DiscordStatus" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="AudioCenterAutostartButton" Style="{StaticResource GhostButton}" Margin="0,6,0,6" HorizontalAlignment="Stretch"
                                Click="AudioCenterAutostart_Click" Visibility="Collapsed"
                                ToolTip="Официальный Audio Center запускается с Windows и может перезаписывать ваши настройки звука">
                            <TextBlock Text="Убрать Audio Center из автозагрузки"/>
                        </Button>
                        <CheckBox x:Name="UpdatesSwitch" Style="{StaticResource Switch}" Content="Проверять обновления" Click="UpdatesSwitch_Click"/>
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="CheckUpdateButton" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="CheckUpdate_Click" Content="Проверить"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="Banner" Visibility="Collapsed" Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource BannerBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BannerText" Margin="10,0,0,0" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <Border Grid.Row="1" Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="4"
                    HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabEq" GroupName="Tab" Style="{StaticResource Segment}" Width="126" Tag="Eq" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Эквалайзер" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabEffects" GroupName="Tab" Style="{StaticResource Segment}" Width="126" Tag="Effects" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE909;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Эффекты" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabMic" GroupName="Tab" Style="{StaticResource Segment}" Width="126" Tag="Mic" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Микрофон" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabAuto" GroupName="Tab" Style="{StaticResource Segment}" Width="126" Tag="Auto" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Авто" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabMixer" GroupName="Tab" Style="{StaticResource Segment}" Width="126" Tag="Mixer" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Микшер" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabRecord" GroupName="Tab" Style="{StaticResource Segment}" Width="126" Tag="Record" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Запись" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ===== Page: equalizer ===== -->
            <Grid x:Name="PageEq" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Listening modes -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                <RadioButton x:Name="ModeGames" GroupName="Mode" Style="{StaticResource ModeCard}" Tag="Games" Margin="0,0,8,0" Checked="Mode_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Игры" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="Шаги, выстрелы, позиционирование" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HkGames" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Opacity="0.7" Margin="0,10,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeMusic" GroupName="Mode" Style="{StaticResource ModeCard}" Tag="Music" Margin="4,0" Checked="Mode_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Музыка" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="Естественный и сбалансированный звук" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HkMusic" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Opacity="0.7" Margin="0,10,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeMovies" GroupName="Mode" Style="{StaticResource ModeCard}" Tag="Movies" Margin="8,0,0,0" Checked="Mode_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Фильмы" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="Глубокий бас и разборчивые диалоги" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HkMovies" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Opacity="0.7" Margin="0,10,0,0"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- Equalizer -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Эквалайзер" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PresetTitle" Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock x:Name="ClipInfo" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource WarnBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <CheckBox x:Name="ClipGuardSwitch" Style="{StaticResource Switch}" Content="Защита от перегруза" Margin="0,4,24,4"
                                      Click="ClipGuardSwitch_Click"
                                      ToolTip="Если полосы подняты выше 0 дБ, общий уровень немного снижается, чтобы звук не хрипел"/>
                            <CheckBox x:Name="EqSwitch" Style="{StaticResource Switch}" Content="Включён" Click="EqSwitch_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- dB scale, rows match the bands grid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="1" Margin="0,0,0,0">
                                <TextBlock Text="+20" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,0"/>
                                <TextBlock Text="0 дБ" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="−20" VerticalAlignment="Bottom" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                            </Grid>
                        </Grid>
                        <Grid x:Name="BandsGrid" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                        </Grid>
                        <!-- shown for headsets without the C-Media equalizer -->
                        <Border x:Name="EqUnavailable" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                                CornerRadius="12" Opacity="0.96">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="0,8">
                                <Border x:Name="EqUnavailableIcon" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource InsetBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource SubTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Эквалайзер недоступен для этих наушников" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,14,0,6"/>
                                <TextBlock x:Name="EqUnavailableText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                           Text="Встроенный эквалайзер есть у гарнитур на чипе C-Media (например io Graphite 2 Pro). Громкость, микрофон, автоматика, анализатор и тесты работают с любыми наушниками."/>
                                <!-- one-click official driver install for io Graphite headsets -->
                                <StackPanel x:Name="DriverOffer" Visibility="Collapsed" Margin="0,18,0,0">
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                                               Text="Похоже, не установлен драйвер наушников. Установить его с официального сайта IO?"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DriverModelCombo" DisplayMemberPath="Title"/>
                                        <Button x:Name="DriverInstallButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="DriverInstall_Click">
                                            <TextBlock x:Name="DriverInstallText" Text="Установить драйвер"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="DriverStatus" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               Text="Для Graphite 2 Wireless FE драйвера у производителя нет — для неё подойдёт вариант ниже."/>
                                </StackPanel>
                                <!-- Equalizer APO: equalizer for any headphones -->
                                <Border x:Name="ApoOffer" Visibility="Collapsed" Margin="0,18,0,0" Padding="16,14" CornerRadius="12"
                                        Background="{DynamicResource InsetBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="ApoTitle" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Text="Эквалайзер для любых наушников"/>
                                        <TextBlock x:Name="ApoText" Margin="0,6,0,12" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   Text="SoundShot поставит бесплатный Equalizer APO и будет управлять им сам. В его окне один раз отметьте свои наушники, потом перезагрузите компьютер."/>
                                        <Button x:Name="ApoButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" MinWidth="220" Click="ApoButton_Click">
                                            <TextBlock x:Name="ApoButtonText" Text="Включить эквалайзер"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Click="Reset_Click" ToolTip="Вернуть заводские значения этого пресета">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Сбросить пресет" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FlatButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Flat_Click" ToolTip="Все полосы на 0 дБ">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ровно" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CompareButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    PreviewMouseLeftButtonDown="Compare_Down" PreviewMouseLeftButtonUp="Compare_Up" MouseLeave="Compare_Leave"
                                    ToolTip="Держите — звук без эквалайзера и эффектов, отпустите — снова ваш. Горячая клавиша переключает">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CompareText" Text="Сравнить" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="AnalyzerSwitch" Style="{StaticResource Switch}" Content="Анализатор" Margin="0,0,16,0"
                                      Click="AnalyzerSwitch_Click" ToolTip="Показывать за кривой, какие частоты звучат сейчас"/>
                            <Button x:Name="HearingTestButton" Style="{StaticResource AccentButton}" Click="HearingTest_Click"
                                    ToolTip="2–3 минуты: эквалайзер подстроится под ваш слух · колёсико мыши — шаг 1 дБ, двойной клик — 0 дБ">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Тест слуха" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            </Grid>

            <!-- ===== Page: effects ===== -->
            <Grid x:Name="PageEffects" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Звуковые эффекты" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Работают вместе с эквалайзером и применяются сразу." Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="LinkEffectsSwitch" Style="{StaticResource Switch}" Content="Свои эффекты для каждого режима"
                                  Margin="0,0,16,0" Click="LinkEffectsSwitch_Click"
                                  ToolTip="Игры, Музыка, Фильмы и ваши пресеты запоминают свой набор эффектов"/>
                        <Button x:Name="ResetEffectsButton" Style="{StaticResource GhostButton}" Click="ResetEffects_Click"
                                ToolTip="Выключить все эффекты и вернуть стандартные уровни">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="Стандартные" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="EffectsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="EffectsProfileText" Margin="2,0,0,8" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock x:Name="EffectsEmpty" Visibility="Collapsed" Margin="2,4,0,12" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                   Text="У этих наушников нет встроенных эффектов C-Media. Проверка каналов ниже работает с любыми наушниками."/>
                        <UniformGrid x:Name="OutputEffectsGrid" Columns="2" Margin="-6,0" VerticalAlignment="Top"/>
                        <!-- Channel test -->
                        <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource InsetBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="Проверка каналов" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ChannelTestText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Короткий шум по очереди из каждого канала. С включённым 7.1 удобно проверить, откуда слышен звук."/>
                                </StackPanel>
                                <Button x:Name="ChannelTestButton" Grid.Column="2" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Click="ChannelTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ChannelTestIcon" Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ChannelTestButtonText" Text="Запустить" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Page: microphone ===== -->
            <ScrollViewer x:Name="PageMic" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Микрофон" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MicName" Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}" Text="Поиск микрофона…"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="MicMuteButton" Style="{StaticResource IconToggle}" Click="MicMute_Click" ToolTip="Выключить микрофон">
                                    <TextBlock x:Name="MicMuteIcon" Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                                </ToggleButton>
                                <Slider x:Name="MicVolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="12,0"
                                        VerticalAlignment="Center" ValueChanged="MicVolume_ValueChanged"/>
                                <TextBlock x:Name="MicVolumeText" Grid.Column="2" Text="—" Width="44" TextAlignment="Right"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Уровень" FontSize="12" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Width="46"/>
                                <Border x:Name="MicMeterTrack" Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource TrackBrush}" Margin="0,0,12,0">
                                    <Border x:Name="MicMeterFill" HorizontalAlignment="Left" Width="0" CornerRadius="5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#3DDC97" Offset="0"/>
                                                <GradientStop Color="#3DDC97" Offset="0.6"/>
                                                <GradientStop Color="#F5A524" Offset="0.85"/>
                                                <GradientStop Color="#FF4860" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <TextBlock x:Name="MicMeterText" Grid.Column="2" Width="64" TextAlignment="Right" FontSize="12"
                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Text="—"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <UniformGrid x:Name="MicEffectsGrid" Columns="2" Margin="-6,0" VerticalAlignment="Top"/>
                    <!-- RNNoise via Equalizer APO: noise suppression for any microphone -->
                    <Border x:Name="NrCard" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource InsetBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="Шумоподавление для любого микрофона" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NrText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <CheckBox x:Name="NrSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="NrSwitch_Click" Visibility="Collapsed"/>
                                <Button x:Name="NrButton" Style="{StaticResource AccentButton}" Click="NrButton_Click" Visibility="Collapsed">
                                    <TextBlock x:Name="NrButtonText"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Hear yourself -->
                    <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource InsetBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="Слышать себя" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Звук микрофона идёт в наушники — удобно проверить шумоподавление и Magic Voice. Небольшая задержка — это нормально."/>
                            </StackPanel>
                            <CheckBox x:Name="MonitorSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="MonitorSwitch_Click"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="4,4,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                               x:Name="MicHotkeyText"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Page: automation ===== -->
            <ScrollViewer x:Name="PageAuto" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Автопереключение по программам" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                               Text="Когда программа из списка становится активной, включается её режим. Вы ушли из неё — возвращается ваш обычный режим."/>
                                </StackPanel>
                                <CheckBox x:Name="AutoSwitchSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Click="AutoSwitchSwitch_Click"/>
                            </Grid>
                            <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C4;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ForegroundText" Margin="10,0,0,0" Foreground="{DynamicResource SubTextBrush}" Text="Активная программа: —"/>
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Click="FullscreenSwitch_Click"
                                      Content="Видео на весь экран в браузере → режим «Фильмы»"
                                      ToolTip="YouTube, Кинопоиск и любое видео в браузере или Telegram на весь экран. Свернули — вернётся прежний режим"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ПРОГРАММЫ И ИГРЫ"/>
                            <TextBlock Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Выберите программу или игру и звук для неё — он включится сам, пока она на экране. Для каждой программы в списке ниже можно сменить пресет или сделать отдельный звук."/>
                            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="AddApp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Добавить программу…" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Expander Header="Дополнительно: правило по заголовку окна или имени" Margin="0,14,0,0" Foreground="{DynamicResource SubTextBrush}">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="RuleKind" SelectedIndex="0" SelectionChanged="RuleKind_SelectionChanged">
                                    <ComboBoxItem Content="Программа"/>
                                    <ComboBoxItem Content="Заголовок окна"/>
                                </ComboBox>
                                <ComboBox x:Name="RuleProcess" Grid.Column="2" IsEditable="True" DropDownOpened="RuleProcess_DropDownOpened"
                                          ToolTip="Имя программы (например cs2) — или выберите из запущенных"/>
                                <ComboBox x:Name="RuleTarget" Grid.Column="4" DisplayMemberPath="Label"/>
                                <Button Grid.Column="6" Style="{StaticResource AccentButton}" Click="AddRule_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Добавить" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            </Expander>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ВАШИ ПРОГРАММЫ" Margin="0,20,0,8"/>
                            <StackPanel x:Name="RulesPanel"/>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetRules_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Вернуть список по умолчанию" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Page: screen recording / replays ===== -->
            <ScrollViewer x:Name="PageRecord" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- status + actions -->
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,80,0">
                                    <TextBlock Text="Повторы и запись экрана" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RecStatus" Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ReplaySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Click="ReplaySwitch_Click" ToolTip="Постоянно держать последние секунды, чтобы сохранить их одной клавишей"/>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SaveReplayButton" Style="{StaticResource AccentButton}" Click="SaveReplay_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SaveReplayText" Text="Сохранить повтор" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecordButton" Grid.Column="2" Style="{StaticResource GhostButton}" Click="Record_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FF4860" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RecordText" Text="Начать запись" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Click="Screenshot_Click" ToolTip="Сделать скриншот">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}"/>
                                </Button>
                                <Button Grid.Column="6" Style="{StaticResource GhostButton}" Click="OpenRecFolder_Click" ToolTip="Открыть папку с роликами">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="RecHotkeys" Margin="2,12,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- settings -->
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel x:Name="DurationTitle" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="ДЛИТЕЛЬНОСТЬ ПОВТОРА"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DurationCombo" DisplayMemberPath="Label"/>
                                    <Grid x:Name="CustomDurationPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomDurationBox" VerticalContentAlignment="Center" KeyDown="CustomDurationBox_KeyDown"
                                                 ToolTip="Целое число, например 15"/>
                                        <ComboBox x:Name="CustomDurationUnit" Grid.Column="2" SelectedIndex="0">
                                            <ComboBoxItem Content="минут"/>
                                            <ComboBoxItem Content="секунд"/>
                                        </ComboBox>
                                        <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="Применить" Click="CustomDuration_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="DurationHint" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel x:Name="SoundTitle" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="ЗВУК В РОЛИКЕ"/>
                                    </StackPanel>
                                    <CheckBox x:Name="RecSystemSwitch" Style="{StaticResource Switch}" Content="Звук компьютера" Click="RecSetting_Changed"/>
                                    <CheckBox x:Name="RecMicSwitch" Style="{StaticResource Switch}" Content="Микрофон" Click="RecSetting_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,18,0,8">
                                <StackPanel x:Name="MonitorsTitle" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="МОНИТОРЫ И КАЧЕСТВО ЗАПИСИ" Margin="0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="IdentifyMonitors_Click"
                                        ToolTip="На каждом мониторе на 3 секунды появится его номер">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Показать номера" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="MonitorPanel"/>
                            <TextBlock x:Name="MonitorHint" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>

                            <TextBlock Style="{StaticResource CardTitle}" Text="ПАПКА ДЛЯ РОЛИКОВ" Margin="0,16,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InsetBrush}" CornerRadius="8" Padding="12,8">
                                    <TextBlock x:Name="RecFolderText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Выбрать…" Click="ChooseRecFolder_Click"/>
                            </Grid>
                            <TextBlock x:Name="RecInfo" Margin="2,14,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Page: per-program volume ===== -->
            <ScrollViewer x:Name="PageMixer" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <StackPanel Margin="0,0,140,0">
                                <TextBlock Text="Громкость программ" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MixerHint" Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                           Text="Программы, которые сейчас играют звук на выбранном устройстве. Громкость запоминается и восстанавливается при следующем запуске программы."/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Click="MixerRefresh_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Обновить" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="MixerList"/>
                    <TextBlock x:Name="MixerEmpty" Margin="4,4,0,0" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Сейчас ни одна программа не воспроизводит звук на этом устройстве. Включите музыку, игру или видео — и нажмите «Обновить»."/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="4,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HotkeysText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="Hotkeys_Click" ToolTip="Изменить любые горячие клавиши">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                        <TextBlock Text="Горячие клавиши…" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
